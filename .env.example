AURORA_DB_URL=sqlite:///./aurora.db
AURORA_ARTIFACT_DIR=./artifacts
AURORA_API_LOCK_DIR=
AURORA_API_HOST=0.0.0.0
AURORA_API_PORT=8000
AURORA_CONTAINER_NETWORK=aurora-runtime
AURORA_WORKER_IMAGE=aurora-kali-codex:latest
AURORA_WORKER_IMAGE_CORE=aurora-kali-codex:core
AURORA_WORKER_IMAGE_HEAVY=aurora-kali-codex:heavy
AURORA_WORKER_RUNTIME=codex

# Solver Worker runs Codex against the private CC Switch runtime service.
AURORA_CODEX_COMMAND_TEMPLATE=/workspace/runtime/codex-via-cc-switch.sh {prompt_filename} {output_schema_filename} {last_message_filename}
AURORA_CODEX_MODEL_CONTEXT_WINDOW=1000000
AURORA_CODEX_AUTO_COMPACT_TOKEN_LIMIT=800000
AURORA_CODEX_REQUIRE_EXPLICIT_MODEL_METADATA=true
AURORA_CODEX_TRANSCRIPT_MAX_BYTES=2097152
AURORA_CODEX_PROXY_BASE_URL=http://aurora-cc-switch:15723/v1
AURORA_CODEX_TIMEOUT_SECONDS=0
AURORA_CODEX_WORKSPACE_DIR=./codex-workspaces
AURORA_WORKER_CONTROL_BASE_URL=http://host.docker.internal:8000

# Optional proxy used only while building container images.
AURORA_BUILD_PROXY=

# Debug-only direct LLM runtime. Set AURORA_WORKER_RUNTIME=openai_direct to enable.
AURORA_LLM_BASE_URL=https://api.openai.com/v1
AURORA_LLM_API_KEY=
AURORA_LLM_MODEL=gpt-4.1-mini
AURORA_LLM_TIMEOUT_SECONDS=120

# Two-tier solver routing. Leave either blank to fall back to AURORA_LLM_MODEL.
# Planner handles short triage/replanning turns; Solver handles evidence-heavy work.
AURORA_PLANNER_MODEL=
AURORA_SOLVER_MODEL=

# Per-intent execution budgets. Individual Intent.budget values override these defaults.
AURORA_DEFAULT_SOFT_TIMEOUT_SECONDS=300
AURORA_DEFAULT_HARD_TIMEOUT_SECONDS=900
AURORA_DEFAULT_MAX_TOOL_CALLS=12
AURORA_DEFAULT_MAX_REPEAT_FAILURES=2
AURORA_DEFAULT_MAX_AGENT_ACTIONS=20
AURORA_DEFAULT_MAX_ROUTE_REPEATS=2
AURORA_DEFAULT_MAX_NO_PROGRESS_ACTIONS=5
AURORA_DEFAULT_FINALIZE_GRACE_SECONDS=60
AURORA_RESUME_MAX_FILES=100
AURORA_RESUME_MAX_BYTES=67108864
AURORA_MAX_CHALLENGE_GROUP_CONCURRENT=2
AURORA_BROWSER_NAVIGATION_TIMEOUT_SECONDS=15
AURORA_BROWSER_RETRY_TIMEOUT_SECONDS=5
AURORA_BROWSER_DOM_TIMEOUT_SECONDS=5
AURORA_BROWSER_ACTION_TIMEOUT_SECONDS=8

# Dedicated cataloger Agent for the "hands-free" URL import workflow.
# This Agent only classifies supplied pages and never executes Solver tools.
AURORA_CATALOGER_LLM_BASE_URL=https://api.openai.com/v1
AURORA_CATALOGER_LLM_API_KEY=
AURORA_CATALOGER_LLM_MODEL=gpt-4.1-mini
AURORA_CATALOGER_LLM_TIMEOUT_SECONDS=120
AURORA_CATALOGER_AGENT_ENABLED=true
AURORA_CATALOGER_MAX_AGENT_STEPS=12
AURORA_CATALOGER_MAX_PAGES=20
AURORA_CATALOGER_MAX_CANDIDATES=500
AURORA_CATALOGER_MAX_RESPONSE_BYTES=2097152
AURORA_CATALOGER_ATTACHMENT_TIMEOUT_SECONDS=20

# Optional FOFA MCP capability. Leave both values empty to keep fofa.search hidden from Workers.
AURORA_FOFA_EMAIL=
AURORA_FOFA_KEY=
AURORA_FOFA_BASE_URL=https://api.fofa.info/v1/search/all
AURORA_FOFA_TIMEOUT_SECONDS=20

# Same-container Solver subagents. The project-level API flag is also required.
AURORA_SUBAGENTS_ENABLED=false
AURORA_SUBAGENTS_MAX_CONCURRENT=2
AURORA_SUBAGENTS_MAX_PER_WORKER=4

# Optional TSecBench challenge control plane. The token is sent as the
# BENCHMARK_TOKEN request header and is never persisted by Aurora.
# The platform-native BENCHMARK_BASE_URL/BENCHMARK_TOKEN names are also
# supported; the AURORA_TSECBENCH_* names below take precedence when both exist.
AURORA_TSECBENCH_BASE_URL=https://tsecbench.zc.tencent.com
AURORA_TSECBENCH_TOKEN=
AURORA_TSECBENCH_TIMEOUT_SECONDS=20
AURORA_TSECBENCH_MAX_CONCURRENT=3

# Optional container-isolated OpenVPN gateway. Configuration and credentials
# are uploaded through the Web UI and remain disconnected after API restart.
AURORA_OPENVPN_IMAGE=aurora-openvpn:latest
AURORA_OPENVPN_CONTAINER_NAME=aurora-openvpn
AURORA_OPENVPN_CONNECT_TIMEOUT_SECONDS=75
